# Copy to .env and fill in. Never commit .env.

# Tailnet address of this host. Leave empty and Compose refuses to start.
# Get it with: tailscale ip -4
TS_IP=

# LAN bind address for the services that are intentionally LAN-only.
# Change to the tailnet IP to make them private.
LAN_BIND=0.0.0.0

# Nextcloud / MariaDB
DB_ROOT_PASSWORD=change-me
DB_NAME=nextcloud
DB_USER=nextcloud
DB_PASSWORD=change-me

# Host paths
DATA_DIR=/srv/data
MEDIA_DIR=/srv/media

# Where the backup script writes (different physical disk)
BACKUP_DIR=/srv/backup/latest
